      "id": "f6219694-017d-4a9b-a75e-9c99c423bea7",
      "name": "Merge — Context + Data"
    },
    {
      "parameters": {
        "jsCode": "const ctx = items[0]?.json || {};\n\n// Config fields\nconst hdrWeekStart = ctx.hdrWeekStart;       // currently \"Week Start Date\"\nconst hdrEmail = ctx.hdrEmail;               // \"Employee Email\"\nconst hdrStatus = ctx.hdrStatus;             // \"Submission Status\"\nconst hdrSubmissionTs = ctx.hdrSubmissionTs; // \"Submission Timestamp\"\nconst hdrRatesEmail = ctx.hdrRatesEmail;     // \"Employee Email\"\n\nconst weekData = $(\"Compute Week Window\").first().json; \nconst periodKey = weekData.periodKey || \"\";\nconst cutoffISO = weekData.cutoffISO || new Date().toISOString();\nconst cutoffMs = new Date(cutoffISO).getTime();\n\nconst normEmail = (e) => String(e || '').trim().toLowerCase();\nconst normStatus = (s) => String(s || '').trim();\n\nconst parseSubmission = (s) => {\n  if (!s) return NaN;\n  const str = String(s).trim();\n  const ms = Date.parse(str);\n  if (!Number.isNaN(ms)) return ms;\n\n  // Fallback for \"MM/DD/YYYY HH:mm:ss\"\n  const m = str.match(/^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})\\s+(\\d{1,2}):(\\d{2}):(\\d{2})$/);\n  if (!m) return NaN;\n  const MM = Number(m[1]), DD = Number(m[2]), YYYY = Number(m[3]);\n  const hh = Number(m[4]), mm = Number(m[5]), ss = Number(m[6]);\n  return new Date(YYYY, MM - 1, DD, hh, mm, ss).getTime();\n};\n\n// Best-effort parse for \"15 - Dec - 2025\"\nconst parseWorkDate = (s) => {\n  if (!s) return NaN;\n  const str = String(s).trim();\n\n  const ms = Date.parse(str);\n  if (!Number.isNaN(ms)) return ms;\n\n  const m = str.match(/^(\\d{1,2})\\s*-\\s*([A-Za-z]{3})\\s*-\\s*(\\d{4})$/);\n  if (!m) return NaN;\n\n  const dd = Number(m[1]);\n  const mon = m[2].toLowerCase();\n  const yyyy = Number(m[3]);\n  const map = {jan:0,feb:1,mar:2,apr:3,may:4,jun:5,jul:6,aug:7,sep:8,oct:9,nov:10,dec:11};\n  if (map[mon] === undefined) return NaN;\n\n  return new Date(yyyy, map[mon], dd, 0, 0, 0).getTime();\n};\n\n// Compute Monday key YYYY-MM-DD from a date ms\nconst mondayKeyFromMs = (ms) => {\n  const d = new Date(ms);\n  // Monday-based weekday: 1..7 (Mon..Sun)\n  const weekday = ((d.getDay() + 6) % 7) + 1;\n  const monday = new Date(d);\n  monday.setDate(d.getDate() - (weekday - 1));\n  monday.setHours(0,0,0,0);\n\n  const pad = (n) => String(n).padStart(2, '0');\n  return `${monday.getFullYear()}-${pad(monday.getMonth()+1)}-${pad(monday.getDate())}`;\n};\n\nconst allRows = items.map(i => i.json);\n\n// Identify timesheet rows by strong markers you have\nconst isTimesheetRow = (row) =>\n  row && row[\"Work Description\"] !== undefined && row[hdrStatus] !== undefined;\n\n// Identify rates rows: anything that is NOT a timesheet row but has Employee Email\nconst isRatesRow = (row) =>\n  row && row[hdrRatesEmail] !== undefined && !isTimesheetRow(row);\n\n// Build roster\nconst roster = new Set();\nfor (const row of allRows) {\n  if (!isRatesRow(row)) continue;\n  const email = normEmail(row[hdrRatesEmail]);\n  if (email) roster.add(email);\n}\nconst rosterList = Array.from(roster);\n\n// Filter period rows\nconst periodRows = [];\nfor (const row of allRows) {\n  if (!isTimesheetRow(row)) continue;\n\n  const email = normEmail(row[hdrEmail]);\n  if (!email) continue;\n\n  let wk = String(row[hdrWeekStart] || '').trim();\n\n  // If wk is not a date key, try compute from Work Date\n  if (!wk.match(/^\\d{4}-\\d{2}-\\d{2}/)) {\n    const workMs = parseWorkDate(row[\"Work Date\"]);\n    if (!Number.isNaN(workMs)) wk = mondayKeyFromMs(workMs);\n  }\n\n  const matchesPeriod = (wk === periodKey) || wk.startsWith(periodKey);\n  if (!matchesPeriod) continue;\n\n  periodRows.push({\n    email,\n    status: normStatus(row[hdrStatus]),\n    submissionTs: row[hdrSubmissionTs] ? String(row[hdrSubmissionTs]).trim() : ''\n  });\n}\n\n// Determine submitted/approved and late\nconst submitted = new Set();\nconst lateSubmissions = [];\n\nfor (const r of periodRows) {\n  if (r.status !== \"Submitted\" && r.status !== \"Approved\") continue;\n  submitted.add(r.email);\n\n  const subMs = parseSubmission(r.submissionTs);\n  if (!Number.isNaN(subMs) && subMs > cutoffMs) {\n    lateSubmissions.push({ email: r.email, submissionTs: r.submissionTs });\n  }\n}\n\n// Missing submissions (if roster is available)\nconst missing = rosterList.length ? rosterList.filter(e => !submitted.has(e)) : [];\n\nconst runTs = new Date().toISOString();\nconst auditRows = [];\n\nfor (const email of missing) {\n  auditRows.push({\n    Timestamp: runTs,\n    Actor: \"SYSTEM:n8n\",\n    Event_Type: \"MISSING_SUBMISSION\",\n    Entity_ID: `${email}::${periodKey}`,\n    Notes: JSON.stringify({ periodKey, cutoffISO })\n  });\n}\n\nfor (const x of lateSubmissions) {\n  auditRows.push({\n    Timestamp: runTs,\n    Actor: \"SYSTEM:n8n\",\n    Event_Type: \"LATE_SUBMISSION\",\n    Entity_ID: `${x.email}::${periodKey}`,\n    Notes: JSON.stringify({ periodKey, cutoffISO, submissionTs: x.submissionTs })\n  });\n}\n\nconst missingCount = missing.length;\nconst lateCount = lateSubmissions.length;\n\nconst missingLines = missingCount ? missing.map(e => `• ${e}`).join('\\n') : '• None';\nconst lateLines = lateCount ? lateSubmissions.map(x => `• ${x.email} — ${x.submissionTs}`).join('\\n') : '• None';\n\nconst slackText =\n`*Weekly Cutoff Compliance Scan — Week ${periodKey}*\\n` +\n`Cutoff (SAST): ${cutoffISO}\\n\\n` +\n`*Missing submissions (${missingCount})*\\n${missingLines}\\n\\n` +\n`*Late submissions (${lateCount})*\\n${lateLines}`;\n\nreturn [{\n  ...ctx,\n  rosterCount: rosterList.length,\n  periodRowsCount: periodRows.length,\n  missingCount,\n  lateCount,\n  auditRows,\n  slackText\n}];\n"
      },
