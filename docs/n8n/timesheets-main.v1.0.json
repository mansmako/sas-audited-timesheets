    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of $input.all()) {\n  item.json.myNewField = 1;\n}\n// Uses the Schedule Trigger time (already SAST in your trigger output)\n// and computes the weekly period boundaries.\n\nconst now = new Date($json.timestamp ?? new Date().toISOString()); // prefer trigger timestamp\nconst day = now.getDay(); // 0=Sun..6=Sat\n\n// Monday 00:00 of current week (if Sunday, go back 6 days)\nconst diffToMonday = (day === 0) ? 6 : (day - 1);\n\nconst weekStart = new Date(now);\nweekStart.setDate(now.getDate() - diffToMonday);\nweekStart.setHours(0, 0, 0, 0);\n\n// Sunday 23:59:59.999 of same week\nconst cutoff = new Date(weekStart);\ncutoff.setDate(weekStart.getDate() + 6);\ncutoff.setHours(23, 59, 59, 999);\n\n// Period key = YYYY-MM-DD (Monday)\nconst pad = (n) => String(n).padStart(2, '0');\nconst periodKey = `${weekStart.getFullYear()}-${pad(weekStart.getMonth() + 1)}-${pad(weekStart.getDate())}`;\n\nreturn [{\n  ...$json,\n  weekStartISO: weekStart.toISOString(),\n  cutoffISO: cutoff.toISOString(),\n  periodKey\n}];\n\nreturn $input.all();"
      },
